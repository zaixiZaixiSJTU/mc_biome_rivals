{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/match-event-batch.schema.json",
  "title": "MatchEventBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "rulesetVersion", "revision", "acknowledgedCommandId", "events"],
  "properties": {
    "protocolVersion": { "const": 18 },
    "rulesetVersion": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "acknowledgedCommandId": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "type", "payload"],
        "properties": {
          "eventId": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["MULLIGAN_COMPLETED", "MATCH_STARTED", "MATERIALS_CONSUMED", "CARD_DEPLOYED", "OBJECT_SUMMONED", "CARD_PLAYED", "CARD_EQUIPPED", "EQUIPMENT_DURABILITY_CHANGED", "EQUIPMENT_DESTROYED", "CARD_BURIED", "CHOICE_OFFERED", "CHOICE_RESOLVED", "CARD_EXCAVATED", "CARD_DRAWN", "CARD_BURNED", "CARD_GENERATED", "FATIGUE_DAMAGE", "HERO_DAMAGED", "HERO_HEALED", "ARMOR_GAINED", "OBJECT_STATS_CHANGED", "OBJECT_STATUS_APPLIED", "OBJECT_STATUS_REMOVED", "OBJECT_MOVED", "PHASE_CHANGED", "ATTACK_RESOLVED", "OBJECT_DIED", "TURN_ENDED", "TURN_STARTED", "PLAYER_CONCEDED", "MATCH_ENDED"] },
          "payload": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "MULLIGAN_COMPLETED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "hand", "handCount", "deckCount", "replacedCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "hand": { "type": "array", "items": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" } },
                    "handCount": { "type": "integer", "minimum": 3, "maximum": 4 },
                    "deckCount": { "type": "integer", "minimum": 26, "maximum": 27 },
                    "replacedCount": { "type": "integer", "minimum": 0, "maximum": 4 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "MATCH_STARTED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "turn", "activePlayerIndex", "phase"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "turn": { "const": 1 },
                    "activePlayerIndex": { "type": "integer", "minimum": 0, "maximum": 1 },
                    "phase": { "const": "MAIN" }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "MATERIALS_CONSUMED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "craftedCardId", "recipeId", "materials", "handCount", "discardCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "craftedCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "recipeId": { "type": "string", "pattern": "^recipe\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "materials": {
                      "type": "array", "minItems": 1,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["cardId", "count"],
                        "properties": {
                          "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                          "count": { "type": "integer", "minimum": 1 }
                        }
                      }
                    },
                    "handCount": { "type": "integer", "minimum": 1, "maximum": 7 },
                    "discardCount": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_DEPLOYED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["playerId", "instanceId", "cardId", "cardType", "slotKind", "slotIndex", "occupiedSlots", "paymentMethod", "redstone", "attack", "health", "maxHealth", "summonedTurn", "keywords", "nextInstanceId"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "cardType": { "enum": ["UNIT", "BUILDING", "STRUCTURE"] },
                    "slotKind": { "enum": ["UNIT", "BUILDING"] },
                    "slotIndex": { "type": "integer", "minimum": 0 },
                    "occupiedSlots": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "paymentMethod": { "enum": ["REDSTONE", "CRAFTING"] },
                    "redstone": { "type": "integer", "minimum": 0, "maximum": 10 },
                    "attack": { "type": "integer", "minimum": 0 },
                    "health": { "type": "integer", "minimum": 1 },
                    "maxHealth": { "type": "integer", "minimum": 1 },
                    "summonedTurn": { "type": "integer", "minimum": 1 },
                    "keywords": { "type": "array", "items": { "enum": ["TAUNT", "CHARGE"] }, "uniqueItems": true },
                    "nextInstanceId": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "OBJECT_SUMMONED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "sourceInstanceId", "effectId", "cardId", "instanceId", "cardType", "slotKind", "slotIndex", "occupiedSlots", "attack", "health", "maxHealth", "summonedTurn", "keywords", "nextInstanceId"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "sourceInstanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "cardType": { "const": "UNIT" },
                    "slotKind": { "const": "UNIT" },
                    "slotIndex": { "type": "integer", "minimum": 0 },
                    "occupiedSlots": { "const": 1 },
                    "attack": { "type": "integer", "minimum": 0 },
                    "health": { "type": "integer", "minimum": 1 },
                    "maxHealth": { "type": "integer", "minimum": 1 },
                    "summonedTurn": { "type": "integer", "minimum": 1 },
                    "keywords": { "type": "array", "items": { "enum": ["TAUNT", "CHARGE"] }, "uniqueItems": true },
                    "nextInstanceId": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_PLAYED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "cardId", "cardType", "effectId", "redstone", "handCount", "discardCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "cardType": { "enum": ["SPELL", "MATERIAL"] },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "redstone": { "type": "integer", "minimum": 0, "maximum": 10 },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "discardCount": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_EQUIPPED" } } },
            "then": { "properties": { "payload": {
              "type": "object", "additionalProperties": false,
              "required": ["playerId", "instanceId", "cardId", "attack", "durability", "maxDurability", "effectId", "redstone", "handCount", "discardCount", "nextInstanceId"],
              "properties": {
                "playerId": { "type": "string", "minLength": 1 },
                "instanceId": { "type": "string", "pattern": "^equipment-[0-9]+$" },
                "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "attack": { "type": "integer", "minimum": 1 },
                "durability": { "type": "integer", "minimum": 1 },
                "maxDurability": { "type": "integer", "minimum": 1 },
                "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                "redstone": { "type": "integer", "minimum": 0, "maximum": 10 },
                "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                "discardCount": { "type": "integer", "minimum": 0 },
                "nextInstanceId": { "type": "integer", "minimum": 1 }
              }
            } } }
          },
          {
            "if": { "properties": { "type": { "const": "EQUIPMENT_DURABILITY_CHANGED" } } },
            "then": { "properties": { "payload": {
              "type": "object", "additionalProperties": false,
              "required": ["playerId", "instanceId", "cardId", "durability", "maxDurability"],
              "properties": {
                "playerId": { "type": "string", "minLength": 1 },
                "instanceId": { "type": "string", "pattern": "^equipment-[0-9]+$" },
                "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "durability": { "type": "integer", "minimum": 0 },
                "maxDurability": { "type": "integer", "minimum": 1 }
              }
            } } }
          },
          {
            "if": { "properties": { "type": { "const": "EQUIPMENT_DESTROYED" } } },
            "then": { "properties": { "payload": {
              "type": "object", "additionalProperties": false,
              "required": ["playerId", "instanceId", "cardId", "reason", "discardCount"],
              "properties": {
                "playerId": { "type": "string", "minLength": 1 },
                "instanceId": { "type": "string", "pattern": "^equipment-[0-9]+$" },
                "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "reason": { "enum": ["REPLACED", "DURABILITY"] },
                "discardCount": { "type": "integer", "minimum": 1 }
              }
            } } }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_BURIED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "effectId", "cardId", "deckCount", "buriedCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "deckCount": { "type": "integer", "minimum": 1 },
                    "buriedCount": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CHOICE_OFFERED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["choiceId", "playerId", "sourceCardId", "sourceInstanceId", "effectId", "kind", "targetPlayerId", "targetInstanceId", "options"],
                  "properties": {
                    "choiceId": { "type": "string", "pattern": "^choice-[0-9]+$" },
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "enum": ["db_003", "or_001", "or_006"] },
                    "sourceInstanceId": { "type": "string", "pattern": "^(object|equipment)-[0-9]+$" },
                    "effectId": { "enum": ["effect.db_003.01", "effect.or_001.01", "effect.or_006.01"] },
                    "kind": { "enum": ["ARCHAEOLOGY_TOP_3", "MOVE_UNIT"] },
                    "targetPlayerId": { "type": "string" },
                    "targetInstanceId": { "type": "string" },
                    "options": {
                      "type": "array", "maxItems": 3,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["optionIndex", "cardId", "slotIndex", "selectable"],
                        "properties": {
                          "optionIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
                          "cardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
                          "slotIndex": { "type": "integer", "minimum": -1, "maximum": 3 },
                          "selectable": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CHOICE_RESOLVED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["choiceId", "playerId", "sourceCardId", "sourceInstanceId", "effectId", "kind", "selectedOptionIndex", "selectedCardId", "selectedSlotIndex"],
                  "properties": {
                    "choiceId": { "type": "string", "pattern": "^choice-[0-9]+$" },
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "enum": ["db_003", "or_001", "or_006"] },
                    "sourceInstanceId": { "type": "string", "pattern": "^(object|equipment)-[0-9]+$" },
                    "effectId": { "enum": ["effect.db_003.01", "effect.or_001.01", "effect.or_006.01"] },
                    "kind": { "enum": ["ARCHAEOLOGY_TOP_3", "MOVE_UNIT"] },
                    "selectedOptionIndex": { "type": "integer", "minimum": -1, "maximum": 2 },
                    "selectedCardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
                    "selectedSlotIndex": { "type": "integer", "minimum": -1, "maximum": 3 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_EXCAVATED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "cardId", "effectId", "destination", "handCount", "deckCount", "discardCount", "buriedCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "destination": { "enum": ["HAND", "DISCARD"] },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "deckCount": { "type": "integer", "minimum": 0 },
                    "discardCount": { "type": "integer", "minimum": 0 },
                    "buriedCount": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "HERO_DAMAGED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "effectId", "damage", "damageType", "life", "armor"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "damage": { "type": "integer", "minimum": 0 },
                    "damageType": { "enum": ["NORMAL", "TRUE"] },
                    "life": { "type": "integer", "minimum": 0 },
                    "armor": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "HERO_HEALED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "effectId", "healing", "life"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "healing": { "type": "integer", "minimum": 0 },
                    "life": { "type": "integer", "minimum": 0, "maximum": 30 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "ARMOR_GAINED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "effectId", "amount", "armor"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "amount": { "type": "integer", "minimum": 0 },
                    "armor": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "OBJECT_STATS_CHANGED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "instanceId", "sourceCardId", "effectId", "reason", "attack", "health", "temporaryAttackModifier", "temporaryAttackModifierExpiresOnTurn"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "sourceCardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
                    "sourceInstanceId": { "type": ["string", "null"], "pattern": "^(object|equipment)-[0-9]+$" },
                    "effectId": { "type": ["string", "null"], "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "reason": { "enum": ["TEMPORARY_ATTACK_MODIFIER", "TEMPORARY_EXPIRED", "DAMAGE", "HEAL"] },
                    "attack": { "type": "integer", "minimum": 0 },
                    "health": { "type": "integer", "minimum": 0 },
                    "temporaryAttackModifier": { "type": "integer" },
                    "temporaryAttackModifierExpiresOnTurn": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "enum": ["OBJECT_STATUS_APPLIED", "OBJECT_STATUS_REMOVED"] } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "instanceId", "statusId", "sourcePlayerId", "sourceCardId", "sourceInstanceId", "effectId", "attack", "health"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "statusId": { "const": "SLOW" },
                    "remainingDuration": { "type": "integer", "minimum": 1 },
                    "sourcePlayerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "sourceInstanceId": { "type": "string" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "statusAttackModifier": { "type": "integer", "maximum": 0 },
                    "boundAttackModifier": { "type": "integer", "maximum": 0 },
                    "reason": { "const": "DURATION_EXPIRED" },
                    "attack": { "type": "integer", "minimum": 0 },
                    "health": { "type": "integer", "minimum": 1 }
                  },
                  "allOf": [
                    {
                      "if": { "required": ["remainingDuration"] },
                      "then": { "required": ["statusAttackModifier", "boundAttackModifier"] },
                      "else": { "required": ["reason"] }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_DRAWN" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "cardId", "handCount", "deckCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "cardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "deckCount": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_BURNED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "cardId", "handCount", "deckCount", "discardCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "deckCount": { "type": "integer", "minimum": 0 },
                    "discardCount": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "CARD_GENERATED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "sourceCardId", "sourceInstanceId", "effectId", "cardId", "destination", "handCount", "discardCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "sourceInstanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                    "cardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
                    "destination": { "enum": ["HAND", "DISCARD"] },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "discardCount": { "type": "integer", "minimum": 0 }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "destination": { "const": "DISCARD" } }, "required": ["destination"] },
                      "then": { "properties": { "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" } } }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "FATIGUE_DAMAGE" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "damage", "fatigueCount", "life", "armor", "handCount", "deckCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "damage": { "type": "integer", "minimum": 1 },
                    "fatigueCount": { "type": "integer", "minimum": 1 },
                    "life": { "type": "integer", "minimum": 0 },
                    "armor": { "type": "integer", "minimum": 0 },
                    "handCount": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "deckCount": { "const": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "PHASE_CHANGED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "phase", "turn"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "phase": { "enum": ["MAIN", "COMBAT"] },
                    "turn": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "OBJECT_MOVED" } } },
            "then": { "properties": { "payload": {
              "type": "object", "additionalProperties": false,
              "required": ["playerId", "instanceId", "cardId", "sourcePlayerId", "sourceCardId", "sourceInstanceId", "effectId", "fromSlotIndex", "toSlotIndex"],
              "properties": {
                "playerId": { "type": "string", "minLength": 1 },
                "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "sourcePlayerId": { "type": "string", "minLength": 1 },
                "sourceCardId": { "enum": ["or_001", "or_006"] },
                "sourceInstanceId": { "type": "string", "pattern": "^(object|equipment)-[0-9]+$" },
                "effectId": { "enum": ["effect.or_001.01", "effect.or_006.01"] },
                "fromSlotIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
                "toSlotIndex": { "type": "integer", "minimum": 0, "maximum": 3 }
              }
            } } }
          },
          {
            "if": { "properties": { "type": { "const": "ATTACK_RESOLVED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["attackerPlayerId", "attackerInstanceId", "targetPlayerId", "targetType", "targetInstanceId", "damageToTarget", "damageToAttacker", "attackerHealth", "attackerArmor", "targetHealth", "targetArmor"],
                  "properties": {
                    "attackerPlayerId": { "type": "string", "minLength": 1 },
                    "attackerInstanceId": { "type": "string", "pattern": "^(object-[0-9]+|HERO)$" },
                    "targetPlayerId": { "type": "string", "minLength": 1 },
                    "targetType": { "enum": ["HERO", "UNIT", "BUILDING"] },
                    "targetInstanceId": { "type": ["string", "null"] },
                    "damageToTarget": { "type": "integer", "minimum": 0 },
                    "damageToAttacker": { "type": "integer", "minimum": 0 },
                    "attackerHealth": { "type": "integer", "minimum": 0 },
                    "attackerArmor": { "type": "integer", "minimum": 0 },
                    "targetHealth": { "type": "integer", "minimum": 0 },
                    "targetArmor": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "OBJECT_DIED" } } },
            "then": {
              "properties": {
                "payload": {
                  "type": "object", "additionalProperties": false,
                  "required": ["playerId", "instanceId", "cardId", "slotKind", "slotIndex", "occupiedSlots", "discardCount"],
                  "properties": {
                    "playerId": { "type": "string", "minLength": 1 },
                    "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                    "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "slotKind": { "enum": ["UNIT", "BUILDING"] },
                    "slotIndex": { "type": "integer", "minimum": 0 },
                    "occupiedSlots": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "discardCount": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
