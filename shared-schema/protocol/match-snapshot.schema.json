{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/match-snapshot.schema.json",
  "title": "MatchSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["matchId", "viewerPlayerId", "protocolVersion", "rulesetVersion", "revision", "lastEventId", "status", "turn", "phase", "activePlayerIndex", "nextInstanceId", "players", "pendingChoice", "winnerPlayerId"],
  "properties": {
    "matchId": { "type": "string", "minLength": 1 },
    "viewerPlayerId": { "type": "string", "minLength": 1 },
    "protocolVersion": { "const": 21 },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "lastEventId": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["WAITING", "MULLIGAN", "ACTIVE", "FINISHED"] },
    "turn": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["MAIN", "COMBAT"] },
    "activePlayerIndex": { "type": "integer", "minimum": 0, "maximum": 1 },
    "nextInstanceId": { "type": "integer", "minimum": 1 },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["playerId", "factionId", "mulliganCompleted", "life", "armor", "redstone", "redstoneCapacity", "hand", "deckCount", "buriedCount", "excavatedThisTurn", "discardPile", "fatigueCount", "equipment", "heroHasAttacked", "triggeredEffectKeysThisTurn", "unitSlots", "buildingSlots", "battlefield"],
        "properties": {
          "playerId": { "type": "string", "minLength": 1 },
          "factionId": { "enum": ["plains_forest", "desert_badlands", "snow_ice", "cave_dark_forest", "ocean_river", "nether", "end"] },
          "mulliganCompleted": { "type": "boolean" },
          "life": { "type": "integer", "minimum": 0 },
          "armor": { "type": "integer", "minimum": 0 },
          "redstone": { "type": "integer", "minimum": 0, "maximum": 10 },
          "redstoneCapacity": { "type": "integer", "minimum": 0, "maximum": 10 },
          "hand": { "type": "array", "items": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" } },
          "deckCount": { "type": "integer", "minimum": 0 },
          "buriedCount": { "type": "integer", "minimum": 0 },
          "excavatedThisTurn": { "type": "boolean" },
          "discardPile": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
          "fatigueCount": { "type": "integer", "minimum": 0 },
          "equipment": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["instanceId", "cardId", "attack", "durability", "maxDurability"],
            "properties": {
              "instanceId": { "type": "string", "pattern": "^equipment-[0-9]+$" },
              "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "attack": { "type": "integer", "minimum": 1 },
              "durability": { "type": "integer", "minimum": 1 },
              "maxDurability": { "type": "integer", "minimum": 1 }
            }
          },
          "heroHasAttacked": { "type": "boolean" },
          "triggeredEffectKeysThisTurn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^object-[0-9]+:effect\\.(pf_005|or_(002|004|007))\\.01$" }
          },
          "unitSlots": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
          },
          "buildingSlots": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" }
          },
          "battlefield": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instanceId", "cardId", "cardType", "attack", "health", "maxHealth", "adjacencyHealthModifier", "slotKind", "slotIndex", "occupiedSlots", "summonedTurn", "hasAttacked", "keywords", "temporaryAttackModifier", "temporaryAttackModifierExpiresOnTurn", "statuses"],
              "properties": {
                "instanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
                "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "cardType": { "enum": ["UNIT", "BUILDING", "STRUCTURE"] },
                "attack": { "type": "integer", "minimum": 0 },
                "health": { "type": "integer", "minimum": 1 },
                "maxHealth": { "type": "integer", "minimum": 1 },
                "adjacencyHealthModifier": { "type": "integer", "minimum": 0, "maximum": 2 },
                "slotKind": { "enum": ["UNIT", "BUILDING"] },
                "slotIndex": { "type": "integer", "minimum": 0 },
                "occupiedSlots": { "type": "integer", "minimum": 1, "maximum": 3 },
                "summonedTurn": { "type": "integer", "minimum": 1 },
                "hasAttacked": { "type": "boolean" },
                "keywords": { "type": "array", "items": { "enum": ["TAUNT", "CHARGE"] }, "uniqueItems": true },
                "temporaryAttackModifier": { "type": "integer" },
                "temporaryAttackModifierExpiresOnTurn": { "type": "integer", "minimum": 0 },
                "statuses": {
                  "type": "array", "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["statusId", "remainingDuration", "sourcePlayerId", "sourceCardId", "sourceInstanceId", "effectId", "attackModifier", "boundAttackModifier"],
                    "properties": {
                      "statusId": { "const": "SLOW" },
                      "remainingDuration": { "type": "integer", "minimum": 1 },
                      "sourcePlayerId": { "type": "string", "minLength": 1 },
                      "sourceCardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                      "sourceInstanceId": { "type": "string" },
                      "effectId": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" },
                      "attackModifier": { "type": "integer", "maximum": 0 },
                      "boundAttackModifier": { "type": "integer", "maximum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pendingChoice": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["choiceId", "playerId", "sourceCardId", "sourceInstanceId", "effectId", "kind", "targetPlayerId", "targetInstanceId", "options"],
      "properties": {
        "choiceId": { "type": "string", "pattern": "^choice-[0-9]+$" },
        "playerId": { "type": "string", "minLength": 1 },
        "sourceCardId": { "enum": ["db_003", "or_001", "or_006", "tk_012"] },
        "sourceInstanceId": { "type": "string", "pattern": "^(object|equipment|effect)-[0-9]+$" },
        "effectId": { "enum": ["effect.db_003.01", "effect.or_001.01", "effect.or_006.01", "effect.tk_012.01"] },
        "kind": { "enum": ["ARCHAEOLOGY_TOP_3", "MOVE_UNIT"] },
        "targetPlayerId": { "type": "string" },
        "targetInstanceId": { "type": "string" },
        "options": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["optionIndex", "cardId", "slotIndex", "selectable"],
            "properties": {
              "optionIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
              "cardId": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
              "slotIndex": { "type": "integer", "minimum": -1, "maximum": 3 },
              "selectable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "winnerPlayerId": { "type": ["string", "null"] }
  }
}
