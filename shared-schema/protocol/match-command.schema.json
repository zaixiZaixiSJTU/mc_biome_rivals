{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/match-command.schema.json",
  "title": "MatchCommandEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "rulesetVersion", "commandId", "expectedRevision", "type", "payload"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "commandId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "type": { "enum": ["DEPLOY_CARD", "END_TURN", "CONCEDE"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "DEPLOY_CARD" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cardId", "slotKind", "slotIndex"],
            "properties": {
              "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "slotKind": { "enum": ["UNIT", "BUILDING"] },
              "slotIndex": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ]
}
