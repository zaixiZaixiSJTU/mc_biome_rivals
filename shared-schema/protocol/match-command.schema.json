{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/match-command.schema.json",
  "title": "MatchCommandEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "rulesetVersion", "commandId", "expectedRevision", "type", "payload"],
  "properties": {
    "protocolVersion": { "const": 6 },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "commandId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "type": { "enum": ["DEPLOY_CARD", "PLAY_CARD", "ENTER_COMBAT", "ATTACK", "END_TURN", "CONCEDE"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "DEPLOY_CARD" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cardId", "slotKind", "slotIndex"],
            "properties": {
              "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "slotKind": { "enum": ["UNIT", "BUILDING"] },
              "slotIndex": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "PLAY_CARD" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["cardId"],
            "properties": {
              "cardId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "targetType": { "enum": ["HERO", "UNIT", "BUILDING"] },
              "targetInstanceId": { "type": "string", "pattern": "^object-[0-9]+$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ATTACK" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attackerInstanceId", "targetType"],
            "properties": {
              "attackerInstanceId": { "type": "string", "pattern": "^object-[0-9]+$" },
              "targetType": { "enum": ["HERO", "UNIT", "BUILDING"] },
              "targetInstanceId": { "type": "string", "pattern": "^object-[0-9]+$" }
            },
            "allOf": [
              {
                "if": { "properties": { "targetType": { "enum": ["UNIT", "BUILDING"] } } },
                "then": { "required": ["targetInstanceId"] }
              }
            ]
          }
        }
      }
    }
  ]
}
