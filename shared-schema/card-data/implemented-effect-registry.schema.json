{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/implemented-effect-registry.schema.json",
  "title": "ImplementedEffectRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contentVersion", "implementedEffectIds"],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "implementedEffectIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^effect\\.[a-z0-9_]+\\.[0-9]{2}$" }
    }
  }
}
