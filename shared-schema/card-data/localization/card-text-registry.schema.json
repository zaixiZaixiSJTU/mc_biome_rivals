{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/card-text-registry.schema.json",
  "title": "CardTextRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "source", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "zh-CN" },
    "source": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nameKey", "name", "rulesTextKey", "rulesText", "typeLabel", "rarityLabel", "tagLabels", "designNotes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "nameKey": { "type": "string", "pattern": "^card\\.[a-z0-9_]+\\.name$" },
          "name": { "type": "string", "minLength": 1 },
          "rulesTextKey": { "type": "string", "pattern": "^card\\.[a-z0-9_]+\\.rules$" },
          "rulesText": { "type": "string" },
          "typeLabel": { "type": "string", "minLength": 1 },
          "rarityLabel": { "type": "string", "minLength": 1 },
          "tagLabels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "designNotes": { "type": "string" }
        }
      }
    }
  }
}
