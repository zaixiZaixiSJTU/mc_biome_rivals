{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/card-name-registry.schema.json",
  "title": "CardNameRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "source", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "zh-CN" },
    "source": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "designId", "nameKey", "name", "collectible"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "designId": { "type": "string", "pattern": "^(PF|DB|SI|CD|OR|NT|ED|TK)-[0-9]{3}$" },
          "nameKey": { "type": "string", "pattern": "^card\\.[a-z0-9_]+\\.name$" },
          "name": { "type": "string", "minLength": 1 },
          "collectible": { "type": "boolean" }
        }
      }
    }
  }
}
