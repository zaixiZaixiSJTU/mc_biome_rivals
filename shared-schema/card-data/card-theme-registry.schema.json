{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/card-theme-registry.schema.json",
  "title": "CardThemeRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layoutId", "themes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "layoutId": { "type": "string", "minLength": 1 },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "frameBase", "frameDark", "accent", "rulesSurface", "titleText", "bodyText", "motif"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "frameBase": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "frameDark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "rulesSurface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "titleText": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "bodyText": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "motif": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
