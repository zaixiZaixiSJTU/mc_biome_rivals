{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/minecraft-world-texture-registry.schema.json",
  "title": "MinecraftWorldTextureRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "edition", "textureRoot", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "edition": { "const": "Java" },
    "textureRoot": { "const": "assets/minecraft/textures/block" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "sourcePath"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "sourcePath": { "type": "string", "pattern": "^assets/minecraft/textures/block/[a-z0-9_./]+\\.png$" }
        }
      }
    }
  }
}
