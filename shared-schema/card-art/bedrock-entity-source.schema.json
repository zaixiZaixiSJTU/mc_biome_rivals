{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biome-rivals.local/schema/bedrock-entity-source.schema.json",
  "title": "BedrockEntitySource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "edition", "sourceRepository", "pinnedCommit", "pinnedCommitDateUtc",
    "sourcePolicy", "redistributionPolicy", "usageGuidelines", "licenseSummary",
    "geometryRoot", "textureRoot", "entityGeometry", "entityTextures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "edition": { "const": "Bedrock" },
    "sourceRepository": { "const": "https://github.com/Mojang/bedrock-samples" },
    "pinnedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pinnedCommitDateUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sourcePolicy": { "const": "OFFICIAL_PUBLIC_SAMPLE_REPOSITORY_DOWNLOAD" },
    "redistributionPolicy": { "const": "DO_NOT_COMMIT_EXTRACTED_ASSETS" },
    "usageGuidelines": { "const": "https://www.minecraft.net/usage-guidelines" },
    "licenseSummary": { "type": "string", "minLength": 40 },
    "geometryRoot": { "const": "resource_pack/models/entity" },
    "textureRoot": { "const": "resource_pack/textures/entity" },
    "entityGeometry": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.geo\\.json$" }
    },
    "entityTextures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.(?:png|tga)$" }
    },
    "localJavaJarExtras": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "type": "string", "pattern": "^assets/minecraft/textures/entity/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.png$" }
    }
  }
}
